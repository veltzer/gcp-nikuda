{
	// This repo's oxlint config: the fleet's shared rules (.oxlintrc.json,
	// byte-identical everywhere, through extends), plus what extends does not
	// carry over: the plugins, the environment this repo's JavaScript runs in,
	// and the globals its pages get from the libraries their <script> tags
	// load, so no-undef knows them and still catches every other undefined name.
	"$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
	"extends": ["./.oxlintrc.json"],
	"plugins": ["eslint"],
	"env": {
		"browser": true,
		"node": true,
		"es2022": true
	},
	"globals": {},
	"overrides": [
		{
			// the guided demo runs after nikuda.js on the same page, and uses what it sets up
			"files": ["src/js/demo.js"],
			"globals": {
				// the answer box, defined by src/js/nikuda.js, which index.html loads before demo.js
				"Answer": "readonly",
				// the main text box, defined by src/js/nikuda.js, which index.html loads before demo.js
				"MainText": "readonly",
				// the vocalize button, defined by src/js/nikuda.js, which index.html loads before demo.js
				"NikudizeButton": "readonly",
				// the vowel-marks pattern, defined by src/js/nikuda.js, which index.html loads before demo.js
				"nikudRegExp": "readonly",
				// the quick-word box, defined by src/js/nikuda.js, which index.html loads before demo.js
				"Quicky": "readonly",
				// the quick-word answer, defined by src/js/nikuda.js, which index.html loads before demo.js
				"QuickyAns": "readonly",
				// the quick-word button, defined by src/js/nikuda.js, which index.html loads before demo.js
				"QuickyButton": "readonly",
				// the UI-string lookup, defined by src/js/nikuda.js, which index.html loads before demo.js
				"S": "readonly"
			}
		}
	]
}
